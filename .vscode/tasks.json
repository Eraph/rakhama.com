{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Hugo Server",
            "type": "shell",
            "command": "hugo",
            "args": [
                "server",
                "-D",
                "--cleanDestinationDir"
            ],
            "options": {
                "cwd": "${workspaceFolder}/"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "hugo",
                "source": "hugo",
                "fileLocation": ["absolute"],
                "background": {
                    "beginsPattern": "^Start building sites",
                    "endsPattern": "^Web Server is available at"
                },
                "pattern": [
                    {
                        "regexp": "^(\\w+) .* : \"(.*):(\\d+):(\\d+)\": \\[\\d+:\\d+\\] (.+)$",
                        "severity": 1,
                        "file": 2,
                        "line": 3,
                        "column": 4,
                        "message": 5
                    }
                ]
            }
        },
        {
            "label": "New Post",
            "type": "shell",
            "command": "hugo new posts/${input:new-post-name};code -r ${workspaceFolder}/content/posts/${input:new-post-name}/index.md",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "new-post-name",
            "type": "promptString",
            "description": "New Post Name",
            "default": "my-new-post"
        }
    ]
}